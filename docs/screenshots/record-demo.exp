#!/usr/bin/expect -f
# Scripted w9s demo for asciinema recording
# Uses content-specific patterns to avoid matching header labels

set timeout 60
set env(W9S_ENABLE_MOCK) 1
set env(TERM) xterm-256color

spawn ./build/w9s --mock

# Wait for dashboard content (not header "Nodes:" label)
expect "By Image:"
sleep 3

# 2 - Nodes view
send "2"
expect "compute"
sleep 2

# Sort
send "s"
expect -re ".+"
sleep 1.5

# YAML view of selected node
send "y"
expect -re ".+"
sleep 3
send "\033"
expect -re ".+"
sleep 1

# Field inheritance view
send "f"
expect -re ".+"
sleep 3
send "\033"
expect -re ".+"
sleep 1

# 3 - Profiles
send "3"
expect "Inheritance"
sleep 3

# 4 - Images
send "4"
expect "rocky9"
sleep 3

# 5 - Overlays
send "5"
expect -re ".+"
sleep 2

# Drill into overlay
send "\r"
expect -re ".+"
sleep 2
send "\033"
expect -re ".+"
sleep 1

# 6 - Power
send "6"
expect -re ".+"
sleep 2

# 1 - Dashboard
send "1"
expect "By Image:"
sleep 2

# Quit
send "q"
expect eof
