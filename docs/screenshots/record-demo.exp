#!/usr/bin/expect -f
# Scripted w9s demo for asciinema recording
# Each send is followed by expect to capture the redraw output

set timeout 10
set env(W9S_ENABLE_MOCK) 1
set env(TERM) xterm-256color

spawn ./build/w9s --mock

# Wait for dashboard to fully render
expect "Total Nodes"
sleep 3

# 2 - Nodes view
send "2"
expect "Cluster"
sleep 2

# Sort
send "s"
expect "Name"
sleep 1.5

# Detail view
send "\r"
expect -re ".+"
sleep 2
send "\033"
expect -re ".+"
sleep 1

# 3 - Profiles
send "3"
expect "Inheritance"
sleep 3

# 4 - Images
send "4"
expect "Size"
sleep 3

# 5 - Overlays
send "5"
expect -re ".+"
sleep 2

# Drill into overlay
send "\r"
expect -re ".+"
sleep 2
send "\033"
expect -re ".+"
sleep 1

# 6 - Power
send "6"
expect -re ".+"
sleep 2

# 1 - Dashboard
send "1"
expect "Total Nodes"
sleep 2

# Quit
send "q"
expect eof
